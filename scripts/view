#!/bin/env python3


import sys
import math
import time
import argparse

from struct      import unpack
from dataclasses import dataclass

import numpy                as np
import matplotlib.pyplot    as plt
import matplotlib.animation as animation
import matplotlib.figure

from gen_bfuncs import lagrange1d


@dataclass
class comp_geom:
  l:  float
  ne: int
  p:  int


def read_hist(filename):

  f = open(filename, 'rb')
  b = f.read()

  l, ne, p, nt, dt = unpack('@dNNNd', b[:40])
  geom             = comp_geom(l, ne, p)

  state_size = (geom.p + 1) * geom.ne

  hist = unpack(f'@{nt * state_size}d', b[40:])
  hist = np.array(hist)
  hist = np.reshape(hist, (nt, geom.ne, geom.p + 1))

  f.close()

  return geom, hist, nt, dt


def main():

  parser = argparse.ArgumentParser(description='very slow plotter for mKS')

  parser.add_argument('-f',
                      required=True,
                      metavar='history_file',
                      help='mKS history file name')
  parser.add_argument('-v',
                      choices=['xt', 'anim'],
                      required=True,
                      metavar='view_type',
                      help='choice of animation or x-t diagram')
  parser.add_argument('-i',
                      type=int,
                      default=1,
                      metavar='increment',
                      help='skip this many steps per frame in animation rendering')
  parser.add_argument('-t',
                      type=float,
                      default=16.67,
                      metavar='frame_time',
                      help='animation frame time in ms')
  parser.add_argument('-s',
                      action='store_true',
                      help='set to save x-t diagram plot')

  options = parser.parse_args()

  eres          = 100
  fname         = options.f
  rend_type     = options.v
  rend_interval = options.i
  frame_time    = options.t
  save_xt       = options.s


  print('reading state history...')
  t1 = time.process_time()

  geom, hist, nt, dt = read_hist(fname)

  t_f = (nt - 1) * dt

  duration = time.process_time() - t1
  print(f'  done in {duration * 1000:.1f}ms')


  print('evaluating state for all space and time...')
  t1 = time.process_time()

  p     = np.linspace(-1., 1., eres)
  basis = np.empty((geom.p + 1, eres))

  for ib in range(geom.p + 1):
    for ip in range(eres):
      basis[ib, ip] = lagrange1d(ib, geom.p, p[ip])

  plotting_hist = np.transpose(np.matmul(hist, basis), axes=(0, 2, 1))

  plotting_max = np.max(plotting_hist)
  plotting_min = np.min(plotting_hist)

  elem_len     = geom.l / geom.ne
  plotting_pos = np.empty((eres, geom.ne))
  for ie in range(geom.ne):
    plotting_pos[:, ie] = ie * elem_len + (0.5 * (p + 1.)) * elem_len

  duration = time.process_time() - t1
  print(f'  done in {duration * 1000:.1f}ms')


  print('rendering...')
  t1 = time.process_time()

  if rend_type == 'xt':

    w, h = matplotlib.figure.figaspect(1.5)
    fig, ax = plt.subplots(figsize=(2. * w, 2. * h))

    ax.set_xlim(0., geom.l)
    ax.set_xlabel('x')
    ax.set_ylabel('t')

    for ie in range(geom.ne):
      ax.imshow(
        plotting_hist[:, :, ie],
        extent=(plotting_pos[0, ie], plotting_pos[-1, ie], 0, t_f),
        vmin=plotting_min,
        vmax=plotting_max,
        origin='lower'
      )

    ax.set_aspect((2. / t_f) / (1. / geom.l))

    if save_xt:
      fig.savefig(f'{fname}.png', dpi=250, bbox_inches='tight')

  elif rend_type == 'anim':

    fig, ax = plt.subplots()

    lines = ax.plot(plotting_pos, plotting_hist[0], 'k')
    ax.set_ylim([plotting_min, plotting_max])

    def update(frame):
      for j in range(len(lines)):
        lines[j].set_xdata(plotting_pos[:, j])
        lines[j].set_ydata(plotting_hist[frame * rend_interval, :, j])
      return lines

    ani = animation.FuncAnimation(fig=fig, func=update,
                                  frames=math.floor(nt / rend_interval),
                                  interval=frame_time)

  else:

    print(f'unknown render type {rend_type}')
    sys.exit(1)

  duration = time.process_time() - t1
  print(f'  done in {duration * 1000:.1f}ms')


  plt.show()


if __name__ == '__main__':

  main()
