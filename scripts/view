#!/bin/env python3


import math
import numpy                as np
import matplotlib.pyplot    as plt
import matplotlib.animation as animation

from struct      import unpack
from dataclasses import dataclass
from gen_bfuncs  import lagrange1d


@dataclass
class comp_geom:
  l:  float
  ne: int
  p:  int


def read_state(filename):

  f = open(filename, 'rb')
  b = f.read()

  l, ne, p = unpack('@dNN', b[:24])
  geom     = comp_geom(l, ne, p)

  state_size = (geom.p + 1) * geom.ne

  state = unpack(f'@{state_size}d', b[24:])
  state = np.array(state)
  state = np.reshape(state, (geom.ne, geom.p + 1));

  f.close()

  return geom, state


def read_hist(filename):

  f = open(filename, 'rb')
  b = f.read()

  l, ne, p, nt = unpack('@dNNN', b[:32])
  geom         = comp_geom(l, ne, p)

  state_size = (geom.p + 1) * geom.ne

  hist = unpack(f'@{nt * state_size}d', b[32:])
  hist = np.array(hist)
  hist = np.reshape(hist, (nt, geom.ne, geom.p + 1))

  f.close()

  return geom, hist, nt


if __name__ == '__main__':

  eres          = 10
  rend_interval = 30

  print('reading state...')

  geom, hist, nt = read_hist('hist.ks')

  print('pre-computing basis functions...')

  p     = np.linspace(-1., 1., eres)
  basis = np.empty((geom.p + 1, eres))

  for ib in range(geom.p + 1):
    for ip in range(eres):
      basis[ib, ip] = lagrange1d(ib, geom.p, p[ip])

  plotting_hist = np.transpose(np.matmul(hist, basis), axes=(0, 2, 1))

  print('computing x-axis positions...')

  elem_len     = geom.l / geom.ne
  plotting_pos = np.empty((eres, geom.ne))
  for ie in range(geom.ne):
    plotting_pos[:, ie] = ie * elem_len + (0.5 * (p + 1.)) * elem_len

  print('plotting...')

  fig, ax = plt.subplots()
  lines = ax.plot(plotting_pos, plotting_hist[0], 'k')

  def update(frame):
    for j in range(len(lines)):
      lines[j].set_xdata(plotting_pos[:, j])
      lines[j].set_ydata(plotting_hist[frame * rend_interval, :, j])
    return lines

  ani = animation.FuncAnimation(fig=fig, func=update,
                                frames=math.floor(nt / rend_interval),
                                interval=17)

  plt.show()
